UID:run-20260924-800@running-plan
DTSTAMP:20260909T070000Z
DTSTART;TZID=Europe/Zagreb:20260924T180000
DTEND;TZID=Europe/Zagreb:20260924T190000
SUMMARY:Run - 4x800m 5K Sharpening
DESCRIPTION:2 km warm-up + 4x800m @ 4:20-4:25/km with 2 min easy jog recovery + 1-1.5 km cool-down.
END:VEVENT

BEGIN:VEVENT
UID:run-20260926-specific@running-plan
DTSTAMP:20260909T070000Z
